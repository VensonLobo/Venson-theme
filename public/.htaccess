# Lobo Travels - Production Apache / LiteSpeed Web Configuration
DirectoryIndex index.html

# Prevent directory listings
Options -Indexes

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # 1. Force HTTPS and canonical non-www domain (lobotravels.com)
  # Fixes Google Search Console: Page with redirect (http://lobotravels.com/ & http://www.lobotravels.com/)
  RewriteCond %{HTTPS} off [OR]
  RewriteCond %{HTTP_HOST} ^www\.lobotravels\.com$ [NC]
  RewriteRule ^(.*)$ https://lobotravels.com/$1 [R=301,L]

  # 2. Redirect legacy WordPress RSS/Atom feed requests to home
  # Fixes Google Search Console: Not found (404) on https://lobotravels.com/feed/
  RewriteRule ^feed(/.*)?$ https://lobotravels.com/ [R=301,L]

  # 3. Enforce trailing slash on directories / pages to prevent duplicate content without canonical
  # Fixes Google Search Console: Duplicate without user-selected canonical
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_URI} !index\.html$
  RewriteCond %{REQUEST_URI} !/$
  RewriteCond %{REQUEST_URI} !\.[a-zA-Z0-9]{2,5}$
  RewriteRule ^(.*)$ https://lobotravels.com/$1/ [R=301,L]

  # 4. Serve existing static files directly
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # 5. Route trailing slash requests to directory index.html if present
  RewriteCond %{DOCUMENT_ROOT}/$1/index.html -f
  RewriteRule ^(.*)/$ $1/index.html [L]

  # 6. Route clean URLs without extension to their index.html
  RewriteCond %{DOCUMENT_ROOT}/$1/index.html -f
  RewriteRule ^([^.]+)$ $1/index.html [L]

  # 7. Fallback to 404 page
  RewriteRule ^ - [L]
</IfModule>

# Custom Error Document
ErrorDocument 404 /404.html

# Cache static assets
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/html "access plus 0 seconds"
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType image/png "access plus 1 year"
  ExpiresByType image/jpeg "access plus 1 year"
  ExpiresByType image/webp "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 1 year"
  ExpiresByType font/woff2 "access plus 1 year"
  ExpiresByType application/xml "access plus 1 hour"
  ExpiresByType text/xml "access plus 1 hour"
</IfModule>

# Security Headers
<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>
